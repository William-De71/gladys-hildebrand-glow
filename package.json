{
  "name": "gladys-hildebrand-glow",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for British smart meters (DCC) through Hildebrand Glowmarkt, the cloud of the Bright app: electricity and gas energy, cost, tariff, half-hours in the Gladys energy screens, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-hildebrand-glow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-hildebrand-glow.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "hildebrand",
    "glow",
    "glowmarkt",
    "bright",
    "smart-meter",
    "dcc",
    "energy",
    "home-automation"
  ]
}
